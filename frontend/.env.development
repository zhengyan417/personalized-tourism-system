# 前端测试开关（开发环境）
# true 表示前端测试模式（默认走同源，便于使用 devServer Mock），false 表示正式后端
VUE_APP_FRONTEND_TEST=true

# 测试后端地址（留空则默认使用同源，此时可直接命中 vue-dev-server 的 mock 接口）
# 例如指向测试网关：
# VUE_APP_API_BASE_URL_TEST=http://dev-gateway.local

# 正式后端地址（仅当 VUE_APP_FRONTEND_TEST=false 时启用；未设置则回退到 VUE_APP_API_BASE_URL 或 http://localhost:5000）
# VUE_APP_API_BASE_URL_PROD=http://localhost:5000
VUE_APP_API_BASE_URL=http://localhost:5000
VUE_APP_USE_MOCK=true
